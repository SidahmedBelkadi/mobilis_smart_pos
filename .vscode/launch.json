{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobilis Smart POS -- DEV",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/dev.json"]
    },
    {
      "name": "Mobilis Smart POS -- STG (ICOSNET)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/stg.json"]
    },
    {
      "name": "Mobilis Smart POS -- PROD",
      "request": "launch",
      "program": "lib/main.dart",
      "type": "dart",
      "args": ["--dart-define-from-file=env/prod.json"]
    },
    {
      "name": "Mobilis Smart POS -- PROD (Release Mode)",
      "flutterMode": "release",
      "request": "launch",
      "program": "lib/main.dart",
      "type": "dart",
      "args": ["--dart-define-from-file=env/prod.json"]
    },
    {
      // Device attestation + request signing against the real backend
      "name": "Mobilis Smart POS -- SECURE (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/dev.json",
        "--dart-define=DEVICE_SECURITY_ENABLED=true"
      ]
    },
    {
      // Same, with a local fake of /device/challenge and /device/register (no backend needed)
      "name": "Mobilis Smart POS -- SECURE MOCK (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/dev.json",
        "--dart-define=DEVICE_SECURITY_ENABLED=true",
        "--dart-define=DEVICE_SECURITY_MOCK=true"
      ]
    },
    {
      // Release-signed APK: the attestation the backend sees is the real one
      "name": "Mobilis Smart POS -- SECURE (Release Mode)",
      "flutterMode": "release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/prod.json",
        "--dart-define=DEVICE_SECURITY_ENABLED=true"
      ]
    }
  ]
}
